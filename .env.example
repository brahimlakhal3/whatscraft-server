# ---------------------------------------------------------------------------
# Whatscraft server configuration
# Copy to .env for local development.  Never commit the real .env.
# ---------------------------------------------------------------------------

# Port the HTTP + WebSocket server listens on.
PORT=8080

# Postgres connection string.
#   * production (Neon):  postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/whatscraft?sslmode=require
#   * leave EMPTY to run on an embedded PGlite database in ./.data (local dev only)
DATABASE_URL=

# Secret used to sign access tokens (JWT HS256). Generate with:
#   openssl rand -base64 48
JWT_SECRET=dev-only-insecure-secret-change-me

# Access token lifetime in seconds (default 15 min).
ACCESS_TTL_SECONDS=900

# Refresh token lifetime in days.
REFRESH_TTL_DAYS=60

# Optional Firebase Cloud Messaging (HTTP v1) for background push notifications.
# Without these the server still relays messages; the app just needs to be open
# (or running its foreground notification service) to receive them.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
